{
    "name": "nowo-tech/composer-update-helper",
    "description": "Generates composer require commands from outdated dependencies. Works with any PHP project (Symfony, Laravel, Yii, CodeIgniter, etc.)",
    "type": "composer-plugin",
    "license": "MIT",
    "keywords": [
        "composer",
        "update",
        "dependencies",
        "outdated",
        "require",
        "symfony",
        "laravel",
        "yii",
        "codeigniter",
        "php"
    ],
    "homepage": "https://github.com/nowo-tech/ComposerUpdateHelper",
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor"
        ]
    },
    "support": {
        "issues": "https://github.com/nowo-tech/ComposerUpdateHelper/issues",
        "source": "https://github.com/nowo-tech/ComposerUpdateHelper"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.1 <8.6",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "symfony/framework-bundle": "^6.0 || ^7.0 || ^8.0",
        "rector/rector": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "suggest": {
        "nowo-tech/code-review-guardian": "Provider-agnostic code review guardian that works perfectly with Composer Update Helper. Ensures code quality in your pull requests with PHP-CS-Fixer, PHPStan, PHPUnit, and security checks."
    },
    "autoload": {
        "psr-4": {
            "NowoTech\\ComposerUpdateHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NowoTech\\ComposerUpdateHelper\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "NowoTech\\ComposerUpdateHelper\\Plugin",
        "branch-alias": {
            "dev-main": "2.0-dev"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --configuration=phpunit.coverage.xml.dist --coverage-text",
        "cs-check": "php-cs-fixer fix --dry-run --config=.php-cs-fixer.dist.php",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "qa": [
            "@cs-check",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run PHPUnit tests with code coverage",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "rector": "Apply Rector upgrades",
        "rector-dry": "Run Rector in dry-run mode",
        "phpstan": "Run PHPStan static analysis",
        "qa": "Run all quality assurance checks"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
